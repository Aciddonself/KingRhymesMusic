{
  "apps": [{
    "name": "king-rhymes",
    "script": "node_modules/next/dist/bin/next",
    "args": "start",
    "instances": 1,
    "exec_mode": "fork",
    "env": {
      "NODE_ENV": "production",
      "PORT": "3000",
      "NEXT_OUTPUT": "default"
    },
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "merge_logs": true,
    "max_restarts": 10,
    "min_uptime": "10s",
    "watch": false
  }]
}