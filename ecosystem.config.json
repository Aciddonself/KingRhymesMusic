{
  "apps": [{
    "name": "king-rhymes",
    "script": "server.js",
    "cwd": "/home/kingrhymes/app",
    "instances": "max",
    "exec_mode": "cluster",
    "env": {
      "NODE_ENV": "production",
      "PORT": "3000"
    },
    "error_file": "/home/kingrhymes/logs/err.log",
    "out_file": "/home/kingrhymes/logs/out.log",
    "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
    "merge_logs": true,
    "max_restarts": 10,
    "min_uptime": "10s",
    "watch": false
  }]
}